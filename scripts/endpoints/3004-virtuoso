#! /usr/bin/bash

# Ensuring our working directory is the script's location
SCRIPT_LOCATION="$(dirname "$(readlink -f "$0")")"
cd "${SCRIPT_LOCATION}" || exit 1
BENCHMARK_ROOT="$(realpath "${SCRIPT_LOCATION}/../..")"

source config.sh

# Becomes available using the following URL:
# localhost:3004/sparql?default-graph-uri=urn:graph:test

ENDPOINT_INSTALL_FOLDER=${BENCHMARK_ROOT}/bin/virtuoso
ENDPOINT_PORT=3004

source common.sh

if [[ -d /tmp/virtuoso ]]; then
	echo "Temporary file location already exists; is an instance already running?"
	exit 1
fi

# Configuring endpoint data before manipulating the path further
if [[ "${ENDPOINT_DATA}" != "" ]]; then
	ENDPOINT_DATA=$(realpath ${ENDPOINT_DATA})
fi

mkdir /tmp/virtuoso
cd /tmp/virtuoso || exit 1

# Creating the config
cat > /tmp/virtuoso/virtuoso.ini<< EOF
[TempDatabase]
DatabaseFile			= /tmp/virtuoso/virtuoso-temp.db
TransactionFile			= /tmp/virtuoso/virtuoso-temp.trx

[Parameters]
; used with the "isql" command, leaving it to the default value
ServerPort			= 1111
DirsAllowed			= $(dirname ${ENDPOINT_DATA} 2> /dev/null || echo "")

[HTTPServer]
ServerPort			= ${ENDPOINT_PORT}
EOF

# Launching the server using said config
"${ENDPOINT_INSTALL_FOLDER}/bin/virtuoso-t" +foreground &
echo "Waiting 10s for the server to start..."
sleep 10

# Uploading the initial data, if any
if [[ "${ENDPOINT_DATA}" != "" ]]; then

${ENDPOINT_INSTALL_FOLDER}/bin/isql 1111 dba dba <<EOF
SPARQL CREATE GRAPH <urn:graph:test>;
ld_dir('$(realpath "$(dirname "${ENDPOINT_DATA}")")', '$(basename "${ENDPOINT_DATA}")', 'urn:graph:test');
rdf_loader_run();
EOF

fi

# We can now await the endpoint and finish upon exiting
on_endpoint_ready "http://localhost:${ENDPOINT_PORT}/sparql?default-graph-uri=urn:graph:test"

# We launched it, so we stop it too
kill -SIGKILL $!

# Cleaning it up
rm -rf /tmp/virtuoso
