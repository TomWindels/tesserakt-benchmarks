#! /usr/bin/bash

# Ensuring our working directory is the script's location
SCRIPT_LOCATION="$(dirname "$(readlink -f "$0")")"
cd "${SCRIPT_LOCATION}" || exit 1
BENCHMARK_ROOT="$(realpath "${SCRIPT_LOCATION}/../..")"

source config.sh

# Becomes available using the following URL:
# SPARQL query:
#  localhost:3002/query
# SPARQL update:
#  localhost:3002/update

ENDPOINT_BIN="${BENCHMARK_ROOT}/bin/oxigraph"
ENDPOINT_PORT=3002

source common.sh

FLAGS="--bind 127.0.0.1:${ENDPOINT_PORT} --union-default-graph"

# First starting the binary manually...
${ENDPOINT_BIN} serve ${FLAGS} &

# ... which has to be actually active...
await_port_in_use

# ...as we need it to set the endpoint data
if [[ "${ENDPOINT_DATA}" != "" ]]; then
	curl -X POST -T "${ENDPOINT_DATA}" -H "Content-Type: application/n-triples" "http://127.0.0.1:${ENDPOINT_PORT}/store?no_transaction" || exit 1
fi

# Now we can await the endpoint to be ready and shutdown when exited, cleaning up after it
on_endpoint_ready "http://localhost:${ENDPOINT_PORT}/query" "http://localhost:${ENDPOINT_PORT}/update"

# We launched it, so we stop it too
kill $!
