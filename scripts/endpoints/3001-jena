#! /usr/bin/bash

# Ensuring our working directory is the script's location
SCRIPT_LOCATION="$(dirname "$(readlink -f "$0")")"
cd "${SCRIPT_LOCATION}" || exit 1
BENCHMARK_ROOT="$(realpath "${SCRIPT_LOCATION}/../..")"

source config.sh

# Becomes available using the following URL:
# localhost:3001/sparql

ENDPOINT_PORT=3001
ENDPOINT_BIN="${BENCHMARK_ROOT}/bin/jena-endpoint"

source common.sh

rm -rf /tmp/jena
mkdir -p /tmp/jena
cat > /tmp/jena/log4j2.properties<< EOF
rootLogger.level = ERROR
EOF

# `sparql` is the endpoint path
FLAGS="--update --port ${ENDPOINT_PORT} sparql"

if [[ "${ENDPOINT_DATA}" != "" ]]; then
	FLAGS="--file ${ENDPOINT_DATA} ${FLAGS}"
else
	FLAGS="--mem ${FLAGS}"
fi

"${ENDPOINT_BIN}" -Dlog4j2.configurationFile=/tmp/jena/log4j2.properties ${FLAGS} &

on_endpoint_ready "http://localhost:${ENDPOINT_PORT}/sparql/query" "http://localhost:${ENDPOINT_PORT}/sparql/update"

kill -SIGKILL $!

# Cleaning up some of the data jena tends to leave behind
rm -rf "${SCRIPT_LOCATION}/run"
