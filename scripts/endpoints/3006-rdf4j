#! /usr/bin/bash

echo "RDF4J script is currently non-functional"
exit 1

# Ensuring our working directory is the script's location
SCRIPT_LOCATION="$(dirname "$(readlink -f "$0")")"
cd "${SCRIPT_LOCATION}" || exit 1
BENCHMARK_ROOT="$(realpath "${SCRIPT_LOCATION}/../..")"

source config.sh

# Becomes available using the following URL:
# localhost:3006/rdf4j-server/repositories/benchmark

ENDPOINT_PORT=3006

CATALINA_HOME="${BENCHMARK_ROOT}/bin/rdf4j_tomcat"
export CATALINA_HOME
JAVA_OPTS="-Dorg.eclipse.rdf4j.appdata.basedir=${CATALINA_HOME}/rdf4j"
export JAVA_OPTS
chmod +x "${CATALINA_HOME}"/bin/*.sh

# Creating temporary configuration and using it to start the Tomcat server
sed "s/8080/${ENDPOINT_PORT}/g" < "${CATALINA_HOME}"/conf/server.xml > /tmp/srv.xml && "${CATALINA_HOME}"/bin/startup.sh -config /tmp/srv.xml

# Waiting utnil the server is ready
echo "Waiting 10s for the server to start..."
sleep 10

# Configuring the endpoint
curl -f -X PUT "http://localhost:${ENDPOINT_PORT}/rdf4j-server/repositories/benchmark" -H 'Content-Type:text/turtle' -d '
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rep: <http://www.openrdf.org/config/repository#>.
@prefix sr: <http://www.openrdf.org/config/repository/sail#>.
@prefix sail: <http://www.openrdf.org/config/sail#>.

[] a rep:Repository ;
  rep:repositoryID "benchmark" ;
  rdfs:label "Benchmark Repository" ;
  rep:repositoryImpl [
    rep:repositoryType "openrdf:SailRepository" ;
    sr:sailImpl [
      sail:sailType "rdf4j:LmdbStore"
    ]
  ] .
' || exit 1

# Waiting for the repository to be created
echo "Waiting 10s for the repository to be created..."
sleep 10

if [[ "${ENDPOINT_DATA}" != "" ]]; then
	# Setting the data
	curl -f -X PUT -H 'Content-Type:application/n-triples' -T "${ENDPOINT_DATA}" "http://localhost:${ENDPOINT_PORT}/rdf4j-server/repositories/benchmark/statements" || exit 1
fi

# Now we can launch the launch script, which will take care of the rest
bash launch.sh "${ENDPOINT_PORT}"

# Shutting the server down
"${CATALINA_HOME}"/bin/shutdown.sh
