#! /usr/bin/bash

# Ensuring our working directory is the script's location
SCRIPT_LOCATION="$(dirname "$(readlink -f "$0")")"
cd "${SCRIPT_LOCATION}" || exit 1
BENCHMARK_ROOT="$(realpath "${SCRIPT_LOCATION}/../..")"

source config.sh

# Becomes available using the following URL:
# localhost:3000/sparql

ENDPOINT_JAR="${BENCHMARK_ROOT}/bin/tesserakt-endpoint.jar"
ENDPOINT_PORT=3000

source common.sh

FLAGS="--port ${ENDPOINT_PORT}"

if [[ "${ENDPOINT_DATA}" != "" ]]; then
	FLAGS="--from-file ${ENDPOINT_DATA} $FLAGS"
fi

if [[ "${ENABLE_QUERY_CACHE}" == 0 ]]; then
	FLAGS="--disable-cache $FLAGS"
fi

"${JAVA_BIN}" ${JAVA_FLAGS} -jar "${ENDPOINT_JAR}" ${FLAGS} &

on_endpoint_ready "http://localhost:${ENDPOINT_PORT}/sparql"

# We launched it, so we stop it too
kill $!
