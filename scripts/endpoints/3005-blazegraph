#! /usr/bin/bash

# Ensuring our working directory is the script's location
SCRIPT_LOCATION="$(dirname "$(readlink -f "$0")")"
cd "${SCRIPT_LOCATION}" || exit 1
BENCHMARK_ROOT="$(realpath "${SCRIPT_LOCATION}/../..")"

source config.sh

# Becomes available using the following URL:
# localhost:3005/blazegraph/sparql

ENDPOINT_PORT=3005
ENDPOINT_JAR="${BENCHMARK_ROOT}/bin/blazegraph.jar"

source common.sh

FLAGS="-Djetty.port=${ENDPOINT_PORT}"

# We need to launch it manually, await for it to be ready, and then set the data
"${JAVA_BIN}" ${JAVA_FLAGS} ${FLAGS} -jar "${ENDPOINT_JAR}" &

if [[ "${ENDPOINT_DATA}" != "" ]]; then
	echo "Waiting 10s for the server to start..."
	sleep 10
	# Now the data can be added
	curl -f -X POST -T "${ENDPOINT_DATA}" -H "Content-Type: text/turtle" "http://localhost:${ENDPOINT_PORT}/blazegraph/sparql" || exit 1
fi

# Now we can await the endpoint to be ready and shutdown when exited, cleaning up after it
on_endpoint_ready "http://localhost:${ENDPOINT_PORT}/blazegraph/sparql" "http://localhost:${ENDPOINT_PORT}/blazegraph/sparql"

# We're done now, so we can shut it down again
kill $!
# Cleaning up some of the data blazegraph tends to leave behind
rm -rf "${SCRIPT_LOCATION}/blazegraph.jnl"
rm -rf "${SCRIPT_LOCATION}/rules.log"
